POSTGRES_DB=trading
POSTGRES_USER=trading
ATLAS_MF_NAV_AUTO_REFRESH_ENABLED=true
# Optional AMFI-derived third-party disclosure feed; enable only after confirming usage rights.
ATLAS_MF_DISCLOSURE_AUTO_REFRESH_ENABLED=false
# Required. Generate a unique value; never commit the populated .env file.
POSTGRES_PASSWORD=replace_with_a_unique_random_password
MARKET_DATA_PROVIDER=MANUAL_CSV
MARKET_DATA_AUTO_REFRESH=false
MARKET_DATA_RATE_PER_SECOND=1
# Optional authorized real-time Upstox feed. The browser receives validated
# ticks by server push; it does not poll Upstox every 30 seconds.
MARKET_DATA_USAGE_RIGHTS_CONFIRMED=false
MARKET_DATA_ENTITLEMENT_CONFIRMED=false
ATLAS_UPSTOX_FEED_ENABLED=false
UPSTOX_ACCESS_TOKEN=
# Automatic historical discovery uses the same authorized market-data token.
# Requires both MARKET_DATA_*_CONFIRMED flags above; never borrows a user vault token.
ATLAS_DISCOVERY_HISTORY_ENABLED=true
# Normally leave both selectors empty: ATLAS automatically subscribes saved
# equity holdings plus its index strip. These remain emergency/operator fallbacks.
ATLAS_UPSTOX_INSTRUMENT_IDS=
ATLAS_UPSTOX_INSTRUMENT_KEYS=
POSTGRES_PORT=5432
REDIS_PORT=6379
SPRING_PORT=8080
INTELLIGENCE_PORT=8000
FRONTEND_PORT=5173
APP_ENV=local
# Required. Generate with: ./scripts/configure-local-jwt-secret.sh
ATLAS_JWT_SECRET=
# Secure local browser session lifetime (7 days, maximum accepted value is 30 days).
ATLAS_SESSION_TTL_SECONDS=604800

# AI committee bridge. Generate the shared internal token and enable the proxy with:
#   ./scripts/configure-local-ai-bridge.sh
ATLAS_AI_PROXY_ENABLED=false
INTERNAL_SERVICE_TOKEN=

# Providers are opt-in. Never commit real API keys. Limits are deliberate cost guards.
ATLAS_AI_PROVIDER_ORDER=OLLAMA,GEMINI,GROQ,OPENAI,XAI
ATLAS_EXTERNAL_AI_ALLOWED=false
ATLAS_PAID_AI_ALLOWED=false

# Local Ollama (no cloud key). Install Ollama separately and pull the configured model.
ATLAS_OLLAMA_ENABLED=false
ATLAS_OLLAMA_URL=http://host.docker.internal:11434
ATLAS_OLLAMA_MODEL=llama3.2
ATLAS_OLLAMA_RPM=120
ATLAS_OLLAMA_RPD=10000

# Google Gemini
ATLAS_GEMINI_ENABLED=false
GEMINI_API_KEY=
ATLAS_GEMINI_MODEL=gemini-3.5-flash-lite
ATLAS_GEMINI_RPM=2
ATLAS_GEMINI_RPD=30

# Groq-hosted open models
ATLAS_GROQ_ENABLED=false
GROQ_API_KEY=
ATLAS_GROQ_MODEL=llama-3.3-70b-versatile
ATLAS_GROQ_RPM=5
ATLAS_GROQ_RPD=100

# OpenAI (ChatGPT models via the API; a ChatGPT subscription is not an API key)
ATLAS_OPENAI_ENABLED=false
OPENAI_API_KEY=
ATLAS_OPENAI_MODEL=gpt-4.1-mini
ATLAS_OPENAI_RPM=0
ATLAS_OPENAI_RPD=0

# xAI Grok
ATLAS_XAI_ENABLED=false
XAI_API_KEY=
ATLAS_XAI_MODEL=grok-4.7
ATLAS_XAI_RPM=0
ATLAS_XAI_RPD=0

# Authorized local normalized public deal report inbox (no automated exchange scraping)
ATLAS_DEAL_REPORTS_ENABLED=false

# ECB daily reference rates, research-only; confirm applicable data usage rights
ATLAS_GLOBAL_FX_ENABLED=false

# EIA daily spot oil data (free registered key, local only)
ATLAS_GLOBAL_OIL_ENABLED=false
EIA_API_KEY=
# US Treasury nominal par yields (no key)
ATLAS_GLOBAL_YIELDS_ENABLED=false
