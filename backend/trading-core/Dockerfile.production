# Optional BuildKit named context maven-seed can supply cached Maven artifacts.
# Normal local and release builds use this empty dependency seed stage.
FROM maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS maven-seed
RUN mkdir -p /repository

FROM maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build
WORKDIR /workspace
COPY pom.xml maven-build-retry.sh ./
RUN --mount=type=bind,from=maven-seed,source=/repository,target=/tmp/maven-seed,ro \
    mkdir -p /root/.m2/repository \
    && cp -a /tmp/maven-seed/. /root/.m2/repository/ \
    && sh maven-build-retry.sh -DskipTests dependency:go-offline
COPY src ./src
RUN sh maven-build-retry.sh -DskipTests package

FROM eclipse-temurin:21-jre@sha256:ca73b4d3961703d6d7830a4361f49ef0478f8f28b39defc07bb72f4cc7f834f6
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 atlas \
    && useradd --system --uid 10001 --gid atlas --home-dir /nonexistent --shell /usr/sbin/nologin atlas
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/target/trading-core-0.0.1-SNAPSHOT.jar app.jar
USER 10001:10001
EXPOSE 8080
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -Djava.io.tmpdir=/tmp"
HEALTHCHECK --interval=15s --timeout=5s --retries=12 CMD curl --fail --silent http://127.0.0.1:8080/actuator/health/readiness >/dev/null || exit 1
ENTRYPOINT ["java","-jar","/app/app.jar"]
